{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "host", "value": "menopausedirectory.co" }],
      "destination": "https://www.menopausedirectory.co/$1",
      "permanent": true
    }
  ]
}
